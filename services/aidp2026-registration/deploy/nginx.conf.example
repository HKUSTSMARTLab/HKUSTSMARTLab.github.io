# Adapt server_name, TLS paths, and upstream before use.
# This is an origin safeguard, not a replacement for Cloudflare/EdgeOne.
limit_req_zone $binary_remote_addr zone=aidp2026_submit:10m rate=30r/m;

upstream aidp2026_registration {
    server 127.0.0.1:8787;
    keepalive 16;
}

server {
    listen 443 ssl;
    http2 on;
    server_name aidp2026-api.example.org;

    # Cloudflare → Nginx only: install the companion real-IP configuration.
    # Remove these three lines for direct (non-Cloudflare) ingress.
    include /etc/nginx/aidp2026-cloudflare-real-ip.conf;
    real_ip_header CF-Connecting-IP;
    real_ip_recursive on;

    ssl_certificate     /etc/letsencrypt/live/aidp2026-api.example.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/aidp2026-api.example.org/privkey.pem;

    # Raw PDF uploads are capped again by Node at 5 MiB; JSON metadata is 32 KiB.
    client_max_body_size 5m;
    client_body_timeout 120s;
    client_header_timeout 10s;

    # Never cache API or administrator responses.
    location /api/aidp2026/ {
        limit_req zone=aidp2026_submit burst=10 nodelay;
        limit_req_status 429;

        proxy_pass http://aidp2026_registration;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Send one sanitized client IP; do not append untrusted incoming chains.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_connect_timeout 3s;
        proxy_send_timeout 120s;
        proxy_read_timeout 120s;
        add_header Cache-Control "no-store" always;
    }

    # Optional: serve the conference static pages from this same Node process.
    # Omit this block when the API is a subdomain and GitHub Pages serves HTML.
    location / {
        proxy_pass http://aidp2026_registration;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Send one sanitized client IP; do not append untrusted incoming chains.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_connect_timeout 3s;
        proxy_read_timeout 15s;
    }
}
