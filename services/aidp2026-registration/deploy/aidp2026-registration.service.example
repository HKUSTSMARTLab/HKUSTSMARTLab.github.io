[Unit]
Description=AIDP 2026 registration service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cjinag
WorkingDirectory=/home/amax/Public/HKUSTSMARTLab.github.io/services/aidp2026-registration
Environment=NODE_ENV=production
ExecStart=/usr/local/bin/node server.js
Restart=on-failure
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=false
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/home/amax/Public/HKUSTSMARTLab.github.io/services/aidp2026-registration
MemoryMax=512M
TasksMax=64
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
