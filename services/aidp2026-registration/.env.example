# Node 22.5+ is required. Copy this file to .env and replace every placeholder.
NODE_ENV=development
HOST=127.0.0.1
PORT=8787
SERVE_STATIC=true
# DATA_DIR=/secure/persistent/path/aidp2026

REGISTRATION_OPEN=true
# CONFERENCE_DEADLINE=2026-11-26T23:59:59+08:00
POSTER_DEADLINE=2026-11-13T23:59:59+08:00

# Comma-separated exact browser origins; do not use *.
ALLOWED_ORIGINS=https://hkustsmartlab.github.io,http://127.0.0.1:8787,http://localhost:8787,http://127.0.0.1:8000,http://localhost:8000
# Set to 1 only behind exactly one trusted reverse proxy; keep the origin firewalled.
TRUST_PROXY=0
# Exact direct proxy peer IPs. Defaults to loopback when TRUST_PROXY is enabled.
TRUST_PROXY_IPS=127.0.0.1,::1
# Geo-based provider recommendation. Use cloudflare or edgeone only at a trusted edge.
GEO_PROVIDER=none
# Optional override: CF-IPCountry or EO-Client-IPCountry (case-insensitive).
# GEO_COUNTRY_HEADER=CF-IPCountry
MAX_CONNECTIONS=500
# Live submission rows older than this are purged automatically.
RETENTION_DAYS=180

CAPTCHA_PROVIDER=auto
TURNSTILE_ENABLED=true
# These are Cloudflare's documented always-pass development keys, not production keys.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Cloudflare's dummy Siteverify response uses example.com; replace this in production.
TURNSTILE_EXPECTED_HOSTNAMES=example.com

TENCENT_CAPTCHA_ENABLED=false
TENCENT_CAPTCHA_APP_ID=
TENCENT_CAPTCHA_SECRET_KEY=
# auto: use TC3 when CAM credentials exist, otherwise the app-key compatibility API.
# Recommended production setting: tc3 with a least-privilege CAM subaccount.
TENCENT_CAPTCHA_VERIFY_MODE=auto
# TENCENT_SECRET_ID=
# TENCENT_SECRET_KEY=
# TENCENT_SECURITY_TOKEN=
# Production auto mode is rejected. Legacy production mode also requires
# TENCENT_ALLOW_LEGACY=true as a temporary acknowledgement; prefer tc3.

# Generate with: openssl rand -hex 32 (required in production)
ADMIN_API_TOKEN=
DEBUG_ADMIN_ENABLED=true
# Local development only. Production can never bypass CAPTCHA, even if this is true.
DEBUG_ALLOW_CAPTCHA_BYPASS=false

BODY_LIMIT_BYTES=32768
PDF_MAX_BYTES=5242880
UPLOAD_TOKEN_TTL_MS=900000
REQUEST_TIMEOUT_MS=120000
CAPTCHA_TIMEOUT_MS=5000
CAPTCHA_MAX_CONCURRENCY=20
RATE_LIMIT_API_PER_WINDOW=120
RATE_LIMIT_SUBMIT_PER_WINDOW=10
RATE_LIMIT_MAX_ENTRIES=10000
